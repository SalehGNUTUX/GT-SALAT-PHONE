<?xml version="1.0" encoding="utf-8"?>
<!--
  تراكب المحدِّث الذاتيّ: يُضاف إلى نكهتَي foss وfull (انظر sourceSets في app/build.gradle.kts).
  سياسة غوغل بلاي تمنع تحديث التطبيق نفسه، فبناء المتجر (-PplayStore=true) يستبدل به src/playStore.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- تنزيل وتثبيت التحديث من داخل التطبيق -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application>
        <!-- خدمة تنزيل التحديث في الخلفية (قابلة للاستئناف) -->
        <service
            android:name=".data.UpdateDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
