<?xml version="1.0" encoding="utf-8"?>
<!-- معاينةُ ودجت «مواقيت اليوم» في مُنتقي الودجتات (بياناتٌ تمثيليّة). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:layoutDirection="rtl"
    android:background="@drawable/widget_bg_scrim"
    android:baselineAligned="false"
    android:paddingHorizontal="12dp"
    android:paddingVertical="10dp">

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="الفجر" android:textColor="#E0E0E0" android:textSize="12sp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="05:08" android:textColor="#FFFFFFFF" android:textSize="15sp" />
    </LinearLayout>

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="الظهر" android:textColor="#F0CE7A" android:textSize="12sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="13:34" android:textColor="#F0CE7A" android:textSize="15sp" android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="العصر" android:textColor="#E0E0E0" android:textSize="12sp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="17:16" android:textColor="#FFFFFFFF" android:textSize="15sp" />
    </LinearLayout>

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="المغرب" android:textColor="#E0E0E0" android:textSize="12sp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="20:23" android:textColor="#FFFFFFFF" android:textSize="15sp" />
    </LinearLayout>

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center_horizontal">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="العشاء" android:textColor="#E0E0E0" android:textSize="12sp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="21:53" android:textColor="#FFFFFFFF" android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
