<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- الشبكة (اختياريّة: تحديث المواقيت من API واكتشاف الموقع) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- الموقع لحساب اتّجاه القبلة والمواقيت -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- الإشعارات (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- الإنذارات الدقيقة لإطلاق الأذان في وقته حتى في وضع Doze -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- إعادة جدولة الإنذارات بعد إعادة تشغيل الجهاز -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- إعفاء من تحسين البطاريّة ليصل الأذان في وقته على الأجهزة الصارمة -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- خدمة المقدّمة لتشغيل الأذان كاملاً -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- الكاتم التلقائيّ أثناء الصلاة: تغيير وضع الرنين يتطلّب الوصول لسياسة الإشعارات -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!-- نافذة أذانٍ ملء الشاشة فوق القفل -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- تنزيل وتثبيت التحديث من داخل التطبيق -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".GtSalatApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.GtSalat"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.GtSalat.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- نافذة الأذان ملء الشاشة (تظهر فوق شاشة القفل عبر full-screen intent) -->
        <activity
            android:name=".alarm.AdhanAlarmActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:showOnLockScreen="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:taskAffinity=""
            android:theme="@style/Theme.GtSalat" />

        <!-- خدمة تشغيل الأذان (مقدّمة، نوع تشغيل وسائط) -->
        <service
            android:name=".audio.AdhanService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- خدمة تلاوة القرآن (مقدّمة، وسائط) — تعمل في الخلفيّة والشاشة مغلقة -->
        <service
            android:name=".audio.QuranAudioService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- خدمة الإذاعات (مقدّمة، وسائط) — بثٌّ حيٌّ في الخلفيّة -->
        <service
            android:name=".audio.RadioService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- خدمة الرقية المسموعة (مقدّمة، وسائط) — تعمل في الخلفيّة والشاشة مقفلة -->
        <service
            android:name=".audio.RuqyahAudioService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- خدمة صوت الأذكار المضمَّن (صباح/مساء/نوم، مقدّمة، وسائط) -->
        <service
            android:name=".audio.AdhkarAudioService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- مُستقبِل إطلاق الإنذار عند دخول وقت الصلاة -->
        <receiver
            android:name=".alarm.PrayerAlarmReceiver"
            android:exported="false" />

        <!-- إعادة جدولة الإنذارات بعد الإقلاع (مُعطَّل ابتداءً، يُفعَّل برمجيّاً) -->
        <receiver
            android:name=".alarm.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- مُستقبِل التذكيرات اليوميّة (وِرد/أيّام بيض/آية) -->
        <receiver
            android:name=".alarm.DailyReminderReceiver"
            android:exported="false" />

        <!-- ودجت سطح الهاتف: الصلاة القادمة (مدمج) ومواقيت اليوم (كامل) -->
        <receiver
            android:name=".widget.NextPrayerWidgetReceiver"
            android:exported="false"
            android:label="GT-SALAT — الصلاة القادمة">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_next_prayer" />
        </receiver>
        <receiver
            android:name=".widget.TodayTimesWidgetReceiver"
            android:exported="false"
            android:label="GT-SALAT — مواقيت اليوم">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_today_times" />
        </receiver>
        <receiver
            android:name=".widget.PrayerProgressWidgetReceiver"
            android:exported="false"
            android:label="GT-SALAT — الساعة وتقدّم الصلاة">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_prayer_progress" />
        </receiver>

        <!-- تعطيل مُهيّئ WorkManager الافتراضيّ (نستعمل Hilt) -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- مزوّد ملفّاتٍ لمشاركة حزمة التحديث المُنزَّلة مع مثبّت النظام -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
