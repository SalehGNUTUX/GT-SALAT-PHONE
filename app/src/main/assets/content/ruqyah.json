    {
      "id": "how_to",
      "title": "كيف أرقي نفسي؟",
      "icon": "book",
      "note": "خطواتٌ عمليّةٌ مختصرةٌ للرقية الشرعية.",
      "segments": [
        {
          "label": "1) النيّة والتوكّل",
          "kind": "dua",
          "text": "استحضِر النيّة الصالحة، وأيقِن أنّ الشفاء بيد الله وحده، وأنّ الرقية سببٌ مشروع."
        },
        {
          "label": "2) الطهارة والخشوع",
          "kind": "dua",
          "text": "يُستحبّ أن تكون على طهارة، وأن تُقبِل بقلبك وتخشع، فالرقية دعاءٌ وذكر."
        },
        {
          "label": "3) اقرأ آيات الرقية",
          "kind": "dua",
          "text": "اقرأ الفاتحة وآية الكرسيّ وخواتيم البقرة والإخلاص والمعوّذتين وما تيسّر من آيات الرقية، بتدبّرٍ ويقين."
        },
        {
          "label": "4) الأدعية النبويّة",
          "kind": "dua",
          "text": "أضِف الأدعية الثابتة مثل: «أذهِب البأس ربَّ الناس…» و«بسم الله أرقيك…» و«أعوذ بكلمات الله التامّات…»."
        },
        {
          "label": "5) النفث والمسح",
          "kind": "dua",
          "text": "انفث في يديك (نفخٌ خفيفٌ معه ريق) وامسح ما استطعت من جسدك، أو ضع يدك على موضع الألم أثناء القراءة."
        },
        {
          "label": "6) التكرار والمداومة",
          "kind": "dua",
          "text": "كرّر القراءة ما شئت، وداوِم على أذكار الصباح والمساء فهي حصنٌ يوميّ، ولا تيأس ولا تستعجل."
        },
        {
          "label": "7) لا تلجأ لغير الله",
          "kind": "dua",
          "text": "لا تذهب إلى السحرة والعرّافين، ولا تُعلّق قلبك بغير الله، ولا يمنعك ذلك من الأخذ بالعلاج الطبّيّ."
        }
      ]
    },
    {
      "id": "ahkam",
      "title": "أحكام وتنبيهات الرقية",
      "icon": "shield",
      "note": "ضوابطُ الرقية المشروعة وتنبيهاتٌ مهمّة.",
      "segments": [
        {
          "label": "الرقية المشروعة",
          "kind": "dua",
          "text": "تكون بالقرآن الكريم والأدعية والأذكار النبويّة الثابتة، وبالكلام المفهوم الموافق للشرع."
        },
        {
          "label": "الاعتماد على الله",
          "kind": "dua",
          "text": "الشفاء بيد الله وحده، والرقية سببٌ لا يخلق أثره بنفسه؛ فأخلِص التوكّل على الله."
        },
        {
          "label": "اجتنِب الطلاسم",
          "kind": "dua",
          "text": "تجنّب الطلاسم والألفاظ المجهولة والعزائم غير المفهومة، فذلك بابٌ للشرك والدجل."
        },
        {
          "label": "لا تشخيص قطعيّ",
          "kind": "dua",
          "text": "وجود أعراضٍ صحّيّةٍ أو نفسيّةٍ لا يُثبت وحده سحرًا أو مسًّا أو عينًا؛ فاحذر الجزم بلا بيّنة."
        },
        {
          "label": "العلاج الطبّيّ",
          "kind": "dua",
          "text": "الرقية لا تمنع الاستعانة بالطبّ والدواء عند الحاجة، فالأخذ بالأسباب مشروع."
        },
        {
          "label": "لا تنسب بلا دليل",
          "kind": "dua",
          "text": "لا تنسب عددًا أو فضيلةً أو طريقةً معيّنةً إلى السنّة دون دليلٍ ثابت."
        }
      ]
    }
  ]
