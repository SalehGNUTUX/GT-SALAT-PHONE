# قالبُ إعداد مفتاح رفع نكهة بلاي (full).
# انسخه إلى keystore.properties (المتجاهَل في git) واملأه بعد توليد مفتاحك:
#   keytool -genkey -v -keystore gtsalat-upload.jks -alias gtsalat -keyalg RSA -keysize 2048 -validity 10000
# الحزم الموزَّعة مباشرةً لا تقرأ هذا الملفّ، فلها المفتاح الدائم في ~/.gt-salat-keys/ (انظر signing-fingerprints.txt).

storeFile=gtsalat-upload.jks
storePassword=CHANGE_ME
keyAlias=gtsalat
keyPassword=CHANGE_ME
